# Copy this file to ".env" and fill in your own values.

# Flask secret key: used to sign login sessions. Make it long and random.
SECRET_KEY=change-me-to-a-long-random-string

# Turn on debug mode while developing (auto-reload + error pages)
FLASK_DEBUG=1

# MySQL connection details (we create this database in Phase 2)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=qless_db